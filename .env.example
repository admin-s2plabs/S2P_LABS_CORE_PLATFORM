# ===========================================
# Prokraya - Environment Configuration
# ===========================================
# Copy this file as .env and fill in your values
# cp .env.example .env

# -------------------------------------------
# DATABASE (Required)
# -------------------------------------------
# This is the MASTER/COMMON database. It holds the tenant registry (am_tenant_mst)
# and serves as the template for cloning new tenant databases via Free Trial registration.
# Tenant databases are created with the domain name (e.g., "acme") and cloned from this DB.
# At runtime, the tenant middleware resolves the correct DB from the subdomain/session.
DATABASE_URL=postgresql://username:password@localhost:5432/prokraya
PGHOST=localhost
PGPORT=5432
PGUSER=username
PGPASSWORD=password
PGDATABASE=prokraya

# -------------------------------------------
# SESSION (Required)
# -------------------------------------------
SESSION_SECRET=your-session-secret-key-here

# -------------------------------------------
# APPLICATION
# -------------------------------------------
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000

# -------------------------------------------
# SMTP / EMAIL (Required for notifications)
# -------------------------------------------
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your-email@yourdomain.com
SMTP_PASS=your-email-password
SMTP_FROM=your-email@yourdomain.com

# -------------------------------------------
# AI Services
# -------------------------------------------
# AI provider configuration is managed through the application UI.
# Go to Administration → AI Model Configuration to set up your AI provider.
# No environment variables needed — API keys are stored securely in the database.

# Open Government Data (data.gov.in) API key - India commodity/market datasets
OGD_INDIA_API_KEY=

# Google Merchant API / Google Custom Search API key for Fair Market Price (FMP) lookup
google_api=your_google_api_key_here
# -------------------------------------------
# SSO (Google + Microsoft) — tenant sign-in
# -------------------------------------------
# Register these redirect URIs with each provider (fixed, single callback for all tenants):
#   ${APP_URL}/api/auth/sso/google/callback
#   ${APP_URL}/api/auth/sso/microsoft/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
