<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Bid Audit Report</title>
<style>
body{font-family:Arial,sans-serif;font-size:12px;color:#333;margin:24px}
h1{text-align:center;margin-bottom:10px}
h2{margin-top:22px;background:#f2f2f2;padding:6px}
table{width:100%;border-collapse:collapse;margin:10px 0}
th,td{border:1px solid #666;padding:6px;vertical-align:top}
th{background:#e9ecef}
thead{display:table-header-group}
tr{page-break-inside:avoid}
.header-table td{border:none;padding:4px}
</style>
</head>
<body>

<h1>BID AUDIT REPORT</h1>

<table class="header-table">
<tr><td><b>Generated On</b></td><td>{{defaultValue generatedOn}}</td><td><b>Generated By</b></td><td>{{defaultValue generatedBy}}</td></tr>
<tr><td><b>Report Version</b></td><td>{{defaultValue reportVersion}}</td><td></td><td></td></tr>
</table>

<h2>1. Bid Details</h2>
<table>
<tr><th>Field</th><th>Value</th></tr>
<tr><td>Bid ID</td><td>{{defaultValue bid.bidId}}</td></tr>
<tr><td>Bid Title</td><td>{{defaultValue bid.bidTitle}}</td></tr>
<tr><td>Bid Type</td><td>{{defaultValue bid.bidType}}</td></tr>
<tr><td>Business Entity</td><td>{{defaultValue bid.businessEntity}}</td></tr>
<tr><td>Buyer</td><td>{{defaultValue bid.buyer}}</td></tr>
<tr><td>Requestor</td><td>{{defaultValue bid.requestor}}</td></tr>
<tr><td>Currency</td><td>{{defaultValue bid.currency}}</td></tr>
<tr><td>Bid Status</td><td>{{defaultValue bid.bidStatus}}</td></tr>
<tr><td>Bid Open Date</td><td>{{defaultValue bid.bidOpenDate}}</td></tr>
<tr><td>Bid Close Date</td><td>{{defaultValue bid.bidCloseDate}}</td></tr>
<tr><td>Payment Terms</td><td>{{defaultValue bid.paymentTerms}}</td></tr>
<tr><td>Delivery Location</td><td>{{defaultValue bid.deliveryLocation}}</td></tr>
</table>

<h2>2. Vendor Participation</h2>
<table><thead><tr><th>#</th><th>Vendor</th><th>Invited</th><th>Participated</th><th>Status</th><th>Submitted On</th></tr></thead><tbody>
{{#if vendorParticipation.length}}{{#each vendorParticipation}}
<tr><td>{{inc @index}}</td><td>{{defaultValue vendorName}}</td><td>{{defaultValue invited}}</td><td>{{defaultValue participated}}</td><td>{{defaultValue responseStatus}}</td><td>{{defaultValue submittedOn}}</td></tr>
{{/each}}{{else}}<tr><td colspan="6" align="center">NA</td></tr>{{/if}}
</tbody></table>

<h2>3. Vendor Response Summary</h2>
<table><thead><tr><th>#</th><th>Vendor</th><th>Commercial</th><th>Technical</th><th>Attachments</th><th>Final Status</th></tr></thead><tbody>
{{#if vendorResponseSummary.length}}{{#each vendorResponseSummary}}
<tr><td>{{inc @index}}</td><td>{{defaultValue vendorName}}</td><td>{{defaultValue commercialResponse}}</td><td>{{defaultValue technicalResponse}}</td><td>{{defaultValue attachments}}</td><td>{{defaultValue finalStatus}}</td></tr>
{{/each}}{{else}}<tr><td colspan="6" align="center">NA</td></tr>{{/if}}
</tbody></table>

<h2>4. Approval History</h2>
<table><thead><tr><th>#</th><th>Stage</th><th>Approver</th><th>Decision</th><th>Comments</th><th>Date & Time</th></tr></thead><tbody>
{{#if approvalHistory.length}}{{#each approvalHistory}}
<tr><td>{{inc @index}}</td><td>{{defaultValue stage}}</td><td>{{defaultValue approver}}</td><td>{{defaultValue decision}}</td><td>{{defaultValue comments}}</td><td>{{defaultValue dateTime}}</td></tr>
{{/each}}{{else}}<tr><td colspan="6" align="center">NA</td></tr>{{/if}}
</tbody></table>

<h2>5. Audit Trail</h2>
<table><thead><tr><th>#</th><th>Description</th><th>Performed By</th><th>Date & Time</th><th>Action</th></tr></thead><tbody>
{{#if auditTrail.length}}{{#each auditTrail}}
<tr><td>{{inc @index}}</td><td>{{defaultValue description}}</td><td>{{defaultValue performedBy}}</td><td>{{defaultValue dateTime}}</td><td>{{defaultValue action}}</td></tr>
{{/each}}{{else}}<tr><td colspan="5" align="center">NA</td></tr>{{/if}}
</tbody></table>

<h2>6. Report Summary</h2>
<table>
<tr><td>Vendors Invited</td><td>{{defaultValue summary.vendorsInvited}}</td></tr>
<tr><td>Vendors Responded</td><td>{{defaultValue summary.vendorsResponded}}</td></tr>
<tr><td>Qualified Vendors</td><td>{{defaultValue summary.qualifiedVendors}}</td></tr>
<tr><td>Approval Stages Completed</td><td>{{defaultValue summary.approvalStagesCompleted}}</td></tr>
<tr><td>Total Audit Events</td><td>{{defaultValue summary.totalAuditEvents}}</td></tr>
<tr><td>Report Generated On</td><td>{{defaultValue summary.reportGeneratedOn}}</td></tr>
</table>

</body></html>